# Copie este arquivo para .env e ajuste os valores.
# O .env NÃO deve ser versionado (já está no .gitignore).

# Conexão da API com o MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=biblioteca
MYSQL_PASSWORD=troque-esta-senha
MYSQL_DATABASE=biblioteca

# Usado apenas pelo docker-compose para criar o usuário root do container
MYSQL_ROOT_PASSWORD=troque-esta-senha-root

# true = loga todo SQL gerado pelo ORM (útil para depuração)
SQL_ECHO=false
